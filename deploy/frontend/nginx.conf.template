worker_processes 1;
pid /tmp/nginx.pid;
error_log /dev/stderr warn;
events { worker_connections 512; }
http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    access_log /dev/stdout;
    sendfile on;
    server_tokens off;
    client_body_temp_path /tmp/client_body;
    proxy_temp_path /tmp/proxy;
    fastcgi_temp_path /tmp/fastcgi;
    uwsgi_temp_path /tmp/uwsgi;
    scgi_temp_path /tmp/scgi;
    resolver 127.0.0.11 valid=5s ipv6=off;
    map $host $control_host { default 0; "${CONTROL_OJ_HOST}" 1; }
    map $control_host $root_document { default /index.html; 1 /admin-console.html; }
    server {
        listen 8080;
        root /srv/web;
        client_max_body_size 4m;
        location = /web-healthz { access_log off; default_type text/plain; return 200 "ok\n"; }
        location = /healthz { include /etc/nginx/proxy.conf; }
        location ~ ^/api/admin(?:/|$) {
            if ($control_host = 0) { return 404; }
            include /etc/nginx/proxy.conf;
        }
        location ~ ^/(?:api|internal)(?:/|$) { include /etc/nginx/proxy.conf; }
        location = / {
            add_header Cache-Control "no-store" always;
            add_header Vary "Host" always;
            try_files $root_document =404;
        }
        location ~ ^/admin-console(?:[/.]|$) {
            if ($control_host = 0) { return 404; }
            add_header Cache-Control "no-store" always;
            add_header Vary "Host" always;
            try_files $uri $uri.html =404;
        }
        location ^~ /_next/static/ {
            add_header Cache-Control "public, max-age=31536000, immutable" always;
            try_files $uri =404;
        }
        location / {
            add_header Cache-Control "no-cache" always;
            try_files $uri $uri.html =404;
        }
        location @backend_unavailable {
            default_type application/json;
            add_header Cache-Control "no-store" always;
            add_header Retry-After "3" always;
            return 503 '{"message":"서버에 다시 연결하고 있어요. 잠시 후 다시 시도해 주세요."}';
        }
    }
}
