[Unit]
Description=GamjaOJ isolated multilingual judge coordinator
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/gamjaoj-worker/current
EnvironmentFile=%h/gamjaoj-worker/worker.env
Environment=GAMJAOJ_DOCKER_CONTROL=engine
# 20 slots x 0.5 CPU sandboxes on the 12-core / 16 GB Runner VM (2 cores left for dockerd and the OS);
# the server caps assignments with RUNNER_FUNCTIONAL_SLOTS.
Environment=GAMJAOJ_FUNCTIONAL_SLOTS=20
ExecStart=/usr/bin/python3 -m runner.worker --state-dir %h/gamjaoj-worker/state --slots 20
Restart=on-failure
RestartSec=5
TimeoutStopSec=150
UMask=0077
# Coordinator only (sandboxes run under dockerd): compile/generated caches plus per-slot large-test buffers.
MemoryMax=1536M
CPUQuota=200%

[Install]
WantedBy=default.target
