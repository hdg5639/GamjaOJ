{
  "sourceLimit": 65536,
  "outputLimit": 65536,
  "buildLimit": 8388608,
  "compileCommand": [
    "/bin/sh",
    "-c",
    "javac -J-Xmx128m -J-XX:ActiveProcessorCount=1 -proc:none -encoding UTF-8 -d /classes /work/Main.java >&2 && tar -C /classes -cf - ."
  ],
  "testCommand": [
    "java",
    "-Xms16m",
    "-Xmx128m",
    "-XX:ActiveProcessorCount=1",
    "-XX:+UseSerialGC",
    "-XX:+ExitOnOutOfMemoryError",
    "-XX:-UsePerfData",
    "-cp",
    "/work",
    "Main"
  ],
  "sandboxFlags": [
    "--pull",
    "never",
    "--network",
    "none",
    "--read-only",
    "--init",
    "--user",
    "65534:65534",
    "--cap-drop",
    "ALL",
    "--security-opt",
    "no-new-privileges=true",
    "--cpus",
    "0.5",
    "--memory",
    "384m",
    "--memory-swap",
    "384m",
    "--pids-limit",
    "128",
    "--ulimit",
    "nofile=128:128",
    "--ulimit",
    "fsize=16777216:16777216",
    "--ulimit",
    "core=0:0",
    "--log-driver",
    "none",
    "--tmpfs",
    "/tmp:rw,noexec,nosuid,nodev,size=32m,mode=1777",
    "--tmpfs",
    "/classes:rw,noexec,nosuid,nodev,size=32m,mode=1777",
    "--shm-size",
    "8m"
  ],
  "compileWallSeconds": 30,
  "testWallSeconds": 5,
  "compileKillTimeout": "35s",
  "testKillTimeout": "8s",
  "entrypoint": "/usr/bin/timeout",
  "timeoutSignal": "--signal=KILL",
  "workdir": "/work"
}
